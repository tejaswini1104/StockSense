# ---- Application ----
PROJECT_NAME="StockSense API"
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
# PostgreSQL (default). Create the database first:
#   createdb -U postgres stocksense
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksense

# ---- Security ----
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS (comma separated) ----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Password reset OTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- SMTP (optional) ----
# Leave SMTP_HOST empty to log reset codes to the backend console instead of
# emailing them. Useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@stocksense.local
SMTP_TLS=true
